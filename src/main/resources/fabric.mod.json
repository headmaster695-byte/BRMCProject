{
	"schemaVersion": 1,
	"id": "brmc",
	"version": "${version}",
	"name": "BRMC",
	"description": "James Stevenson's Backrooms / liminal-spaces Fabric mod. First Dimension architecture pass.",
	"authors": [
		"James Stevenson"
	],
	"contact": {
		"sources": "https://github.com/headmaster695-byte/BRMCProject"
	},
	"license": "CC0-1.0",
	"icon": "assets/brmc/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.jamesstevenson.brmc.BrmcMod"
		],
		"client": [
			"com.jamesstevenson.brmc.client.BrmcClient"
		]
	},
	"mixins": [
		"brmc.mixins.json",
		{
			"config": "brmc.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
